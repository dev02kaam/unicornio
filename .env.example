PORT=3000
NODE_ENV=development
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:3000

# Si DATABASE_URL esta vacia, la app guarda los datos en este archivo local.
# Si DATABASE_URL esta definida, la app carga y persiste colecciones en PostgreSQL.
DATABASE_URL=
DATABASE_SSL=true

# Archivo de persistencia local usado cuando DATABASE_URL esta vacia.
DATA_FILE=server/data/runtime-state.json

# Piloto de cuestionarios. Mantener desactivado fuera de sesiones controladas.
QUESTIONNAIRE_PILOT_ENABLED=false

# Clave AES-256 en base64 (32 bytes). Generar, por ejemplo, con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
QUESTIONNAIRE_DATA_KEY=
QUESTIONNAIRE_DATA_KEY_VERSION=v1
QUESTIONNAIRE_SESSION_MAX_MINUTES=120

# Vista funcional sin persistencia ni alertas. Solo está disponible fuera de producción.
QUESTIONNAIRE_PREVIEW_ENABLED=true
