PORT=3000
NODE_ENV=development
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:3000

# Si DATABASE_URL esta vacia, la app guarda los datos en este archivo local.
# Si DATABASE_URL esta definida, la app carga y persiste colecciones en PostgreSQL.
DATABASE_URL=
DATABASE_SSL=true

# Archivo de persistencia local usado cuando DATABASE_URL esta vacia.
DATA_FILE=server/data/runtime-state.json
