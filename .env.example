# Perfil local seguro por defecto. Production valida todas las variables obligatorias al arrancar.
APP_PROFILE=demo
NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:3001
CORS_ORIGIN=http://localhost:3001
SESSION_SECRET=
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
SESSION_COOKIE_SECURE=false

# La aplicacion siempre requiere PostgreSQL. Demo, migraciones y pruebas deben usar bases/roles separados.
DATABASE_URL=
DATABASE_SSL_MODE=disable
# Opcional: si queda vacio, Node.js usa su almacen de autoridades raiz.
DATABASE_CA=
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=30000
# Solo para despliegues iniciales sin datos reales. Production real exige false.
ALLOW_SHARED_DATABASE_ROLE=false
MIGRATION_DATABASE_URL=
MIGRATION_DATABASE_SSL_MODE=disable
MIGRATION_DATABASE_CA=
DEMO_DATABASE_URL=

# Demo: la semilla solo se carga mediante npm run seed:demo y exige localhost + nombre demo/test.
DEMO_SEED_ENABLED=false
PUBLIC_REGISTRATION_ENABLED=true
AUTO_RUN_MIGRATIONS=false
DATA_FILE=

# Cuestionarios supervisados. Mantener el interruptor apagado fuera de un entorno controlado.
QUESTIONNAIRE_PILOT_ENABLED=false
REAL_DATA_PILOT_ENABLED=false
QUESTIONNAIRE_SESSION_MAX_MINUTES=120

# Solo demo local: clave AES-256 base64 de 32 bytes. Production rechaza proveedores env/local.
QUESTIONNAIRE_DATA_KEY=
QUESTIONNAIRE_DATA_KEY_VERSION=v1

# Demo de clientes en Render: crea una variable privada por version de clave.
DATA_KEY_PROVIDER=
DATA_KEY_CURRENT_VERSION=
DATA_KEY_PROVIDER_MODULE=
DATA_KEY_V1=
# Alternativa mediante Secret File o desarrollo local.
DATA_KEYRING_FILE=
KEY_MAINTENANCE_DATABASE_URL=

# Sin datos reales, todos los roles pueden usar correo y contrasena local.
# El interruptor se conserva para configuraciones heredadas; el piloto real lo exige en false.
LOCAL_ADULT_AUTH_ENABLED=false

# OIDC adulto es opcional sin datos reales y obligatorio al activar el piloto real.
OIDC_ENABLED=false
OIDC_AUTO_LINK_VERIFIED_EMAIL=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Opcional: por defecto usa OIDC_CLIENT_ID, como exige el ID token de Auth0.
OIDC_AUDIENCE=
OIDC_REDIRECT_URI=
OIDC_MFA_ACR_VALUES=
# Solo obligatorio cuando REAL_DATA_PILOT_ENABLED=true.
EMERGENCY_ADMIN_TOTP_SECRET=

# Infraestructura y trabajos privilegiados.
TRUST_PROXY=
RETENTION_DATABASE_URL=
RETENTION_DATABASE_SSL_MODE=disable
RETENTION_DATABASE_CA=
RETENTION_RESPONSES_DAYS=
RETENTION_RESULTS_DAYS=
RETENTION_NOTIFICATIONS_DAYS=
RETENTION_SESSIONS_DAYS=
RETENTION_AUDIT_DAYS=

# Solo para desbloquear datos reales, con referencias verificables y aprobadas.
DPIA_APPROVAL_REFERENCE=
EXTERNAL_SECURITY_REVIEW_REFERENCE=
BACKUP_RESTORE_EVIDENCE=
INCIDENT_PROTOCOL_VERSION=
CLINICAL_APPROVAL_REFERENCE=
